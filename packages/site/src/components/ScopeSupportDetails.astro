---
import type { EditorScopeSupport } from '@a1st/aix-schema';
import InlineCodeText from './InlineCodeText.astro';
import SupportAvailabilityBadge from './SupportAvailabilityBadge.astro';
import SupportStatusBadge from './SupportStatusBadge.astro';
import {
   getEditorSupportDescription,
   getScopeTargets,
   isEditorSupported,
} from '../lib/editor-support';

interface Props {
   label: string;
   scope: EditorScopeSupport;
}

const { label, scope } = Astro.props;

const editorSupported = isEditorSupported(scope),
      targets = getScopeTargets(scope),
      editorNote = getEditorSupportDescription(scope),
      aixNote = scope.note;
---

<div class="scope-support-details aix-layout">
   <dt class="scope-support-details__label">{label}</dt>
   <dd class="scope-support-details__value aix-layout">
      <div class="scope-support-details__status-row">
         <span class="scope-support-details__support-group">
            <span class="scope-support-details__support-label">Editor</span>
            <SupportAvailabilityBadge compact supported={editorSupported} />
         </span>
         <span class="scope-support-details__support-group">
            <span class="scope-support-details__support-label">aix</span>
            <SupportStatusBadge compact status={scope.status} />
         </span>
      </div>

      {targets.map((target) => (
         <div class="scope-support-details__path">
            <span class="scope-support-details__support-label">{target.label}</span>
            <code>{target.path}</code>
         </div>
      ))}

      {editorNote && (
         <p class="scope-support-details__note">
            <strong>Editor:</strong> <InlineCodeText text={editorNote} />
         </p>
      )}
      {aixNote && (
         <p class="scope-support-details__note">
            <strong>aix:</strong> <InlineCodeText text={aixNote} />
         </p>
      )}
   </dd>
</div>

<style>
   /* The label sits beside the value when there is room and above it when there is not. */
   .scope-support-details {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0.9rem;
      padding-block: 0.7rem;
      border-block-start: 1px solid var(--sl-color-hairline-light);
   }

   .scope-support-details__label {
      flex: 0 0 4rem;
      font-weight: 600;
   }

   .scope-support-details__value {
      display: grid;
      flex: 1 1 14rem;
      gap: 0.45rem;
      min-inline-size: 0;
      margin: 0;
   }

   .scope-support-details__status-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem 0.9rem;
   }

   .scope-support-details__support-group {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
   }

   .scope-support-details__support-label {
      color: var(--aix-text-muted);
      font-size: 0.82rem;
      font-weight: 600;
   }

   .scope-support-details__path {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.2rem 0.45rem;
   }

   .scope-support-details__path code,
   .scope-support-details__note {
      overflow-wrap: anywhere;
   }

   .scope-support-details__note {
      color: var(--sl-color-gray-2);
      font-size: 0.94em;
      line-height: 1.55;
   }
</style>
