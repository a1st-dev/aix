---
/**
 * Terminal-style code block with window chrome and syntax coloring.
 * Usage: <TerminalBlock title="Terminal" lines={["$ npm install -g @a1st/aix", "$ aix install"]} />
 */
interface Props {
  title?: string;
  lines: string[];
}

const { title = 'Terminal', lines } = Astro.props;
---

<div class="terminal-block">
  <div class="terminal-chrome">
    <span class="terminal-dot terminal-dot--red" aria-hidden="true"></span>
    <span class="terminal-dot terminal-dot--yellow" aria-hidden="true"></span>
    <span class="terminal-dot terminal-dot--green" aria-hidden="true"></span>
    <span class="terminal-title">{title}</span>
  </div>
  <div class="terminal-body">
    {lines.map((line) => (
      <div class="terminal-line">
        {line.startsWith("$") ? (
          <>
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">{line.slice(2)}</span>
          </>
        ) : line.startsWith("#") ? (
          <span class="terminal-comment">{line}</span>
        ) : (
          <span class="terminal-output">{line}</span>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .terminal-block {
    background: var(--aix-surface-deep);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
    font-family: var(--sl-font-system-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    max-width: 640px;
    width: 100%;
    text-align: start;
    box-shadow:
      var(--aix-shadow-raised),
      0 0 0 1px var(--aix-accent-glow);
  }
  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--aix-surface-sunken);
    border-block-end: 1px solid var(--sl-color-hairline-shade);
  }
  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .terminal-dot--red {
    background: var(--aix-error);
  }
  .terminal-dot--yellow {
    background: var(--sl-color-accent);
  }
  .terminal-dot--green {
    background: var(--aix-success);
  }
  .terminal-title {
    margin-inline-start: 8px;
    color: var(--aix-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .terminal-body {
    padding: 16px 20px 20px;
  }
  /* A flex row keeps a wrapped command aligned after the prompt, not under it. */
  .terminal-line {
    display: flex;
    gap: 8px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .terminal-prompt {
    color: var(--sl-color-accent);
    user-select: none;
  }
  .terminal-cmd {
    min-inline-size: 0;
    color: var(--sl-color-white);
  }
  .terminal-output {
    color: var(--sl-color-gray-2);
  }
  .terminal-comment {
    color: var(--aix-text-muted);
    font-style: italic;
  }
</style>
