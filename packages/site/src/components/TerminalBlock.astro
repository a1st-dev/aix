---
/**
 * Terminal-style code block with window chrome and syntax coloring.
 * Usage: <TerminalBlock title="Terminal" lines={["$ npm install -g @a1st/aix", "$ aix install"]} />
 */
interface Props {
  title?: string;
  lines: string[];
  typing?: boolean;
}

const { title = 'Terminal', lines, typing = false } = Astro.props;

const LINE_STAGGER_SECONDS = 0.12;
---

<div class="terminal-block">
  <div class="terminal-chrome">
    <span class="terminal-dot terminal-dot--red" aria-hidden="true"></span>
    <span class="terminal-dot terminal-dot--yellow" aria-hidden="true"></span>
    <span class="terminal-dot terminal-dot--green" aria-hidden="true"></span>
    <span class="terminal-title">{title}</span>
  </div>
  <div class="terminal-body">
    {lines.map((line, i) => (
      <div class="terminal-line reveal" style={`--reveal-delay: ${i * LINE_STAGGER_SECONDS}s`}>
        {line.startsWith("$") ? (
          <>
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">{line.slice(2)}</span>
          </>
        ) : line.startsWith("#") ? (
          <span class="terminal-comment">{line}</span>
        ) : (
          <span class="terminal-output">{line}</span>
        )}
      </div>
    ))}
    {typing && <div class="terminal-cursor" aria-hidden="true" />}
  </div>
</div>

<style>
  .terminal-block {
    --reveal-distance: 0.25rem;

    background: var(--aix-surface-deep);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
    font-family: var(--sl-font-system-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    max-width: 640px;
    width: 100%;
    text-align: start;
    box-shadow:
      var(--aix-shadow-raised),
      0 0 0 1px var(--aix-accent-glow);
  }
  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--aix-surface-sunken);
    border-block-end: 1px solid var(--sl-color-hairline-shade);
  }
  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .terminal-dot--red {
    background: var(--aix-error);
  }
  .terminal-dot--yellow {
    background: var(--sl-color-accent);
  }
  .terminal-dot--green {
    background: var(--aix-success);
  }
  .terminal-title {
    margin-inline-start: 8px;
    color: var(--aix-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .terminal-body {
    padding: 16px 20px 20px;
  }
  /* A flex row keeps a wrapped command aligned after the prompt, not under it. */
  .terminal-line {
    display: flex;
    gap: 8px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .terminal-prompt {
    color: var(--sl-color-accent);
    user-select: none;
  }
  .terminal-cmd {
    min-inline-size: 0;
    color: var(--sl-color-white);
  }
  .terminal-output {
    color: var(--sl-color-gray-2);
  }
  .terminal-comment {
    color: var(--aix-text-muted);
    font-style: italic;
  }
  .terminal-cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: var(--sl-color-accent);
    margin-block-start: 4px;
    vertical-align: text-bottom;
  }

  /* The cursor blinks a few times and then rests, so nothing on the page moves forever. */
  @media (prefers-reduced-motion: no-preference) {
    .terminal-cursor {
      animation: terminal-blink 1s step-end 4;
    }
  }
  @keyframes terminal-blink {
    50% {
      opacity: 0;
    }
  }
</style>
