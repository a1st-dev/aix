---
import type { ComponentProps } from 'astro/types';
import { Icon } from 'astro-icon/components';
import CodeBlock from './CodeBlock.astro';

interface Props {
   label: string;
   title: string;
   description: string;
   code: string;
   language: ComponentProps<typeof CodeBlock>['language'];
   exampleLabel: string;
   href: string;
   linkLabel: string;
}

const { label, title, description, code, language, exampleLabel, href, linkLabel } = Astro.props;
---

<div class="featureCard">
   <div class="featureCard-text">
      <p class="aix-eyebrow featureCard-label">{label}</p>
      <h3 class="featureCard-title">{title}</h3>
      <p class="featureCard-description">{description}</p>
      <a class="featureCard-link" {href}>
         {linkLabel}
         <Icon name="lucide:arrow-up-right" aria-hidden="true" />
      </a>
   </div>
   <figure class="featureCard-example">
      <figcaption>
         <Icon name={language === 'bash' ? 'lucide:terminal' : 'lucide:file-code'} aria-hidden="true" />
         {exampleLabel}
      </figcaption>
      <CodeBlock {code} {language} />
      <slot />
   </figure>
</div>

<style lang="scss">
   .featureCard {
      display: flex;
      flex-wrap: wrap;
      align-items: start;
      gap: 1.25rem clamp(1.5rem, 4vw, 3rem);
      padding-block: clamp(1.5rem, 4vw, 2.5rem);
      border-block-end: 1px solid var(--sl-color-hairline-light);

      &-text,
      &-example {
         min-inline-size: 0;
      }

      &-text {
         flex: 1 1 14rem;
      }

      &-label {
         margin-block-end: 0.4rem;
         color: var(--sl-color-accent);
         font-family: var(--sl-font-system-mono);
      }

      &-title {
         margin-block-end: 0.45rem;
         font-family: var(--aix-font-display);
         font-size: clamp(1.7rem, 3vw, 2.15rem);
         font-weight: 700;
         line-height: 1.06;
         letter-spacing: -0.02em;
         text-wrap: balance;
      }

      &-description {
         max-inline-size: 55ch;
         color: var(--sl-color-gray-2);
         font-size: 0.95rem;
      }

      &-link {
         display: inline-flex;
         align-items: center;
         gap: 0.25rem;
         margin-block-start: 0.8rem;
         color: var(--sl-color-accent);
         font-size: 0.9rem;
         font-weight: 600;
         text-decoration: underline;
         text-underline-offset: 0.2em;

         svg {
            flex: none;
         }

         @media (hover: hover) {
            &:hover {
               color: var(--sl-color-white);
            }
         }
      }

      &-example {
         flex: 2 1 22rem;
         border: 1px solid var(--sl-color-hairline-light);
         border-radius: 0.65rem;
         background: var(--aix-surface-deep);

         figcaption {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.55rem 1rem;
            border-block-end: 1px solid var(--sl-color-hairline-light);
            border-radius: 0.65rem 0.65rem 0 0;
            background: var(--aix-surface-sunken);
            color: var(--sl-color-gray-2);
            font-family: var(--sl-font-system-mono);
            font-size: 0.78rem;

            svg {
               color: var(--sl-color-accent);
            }
         }

         :global(pre) {
            padding: 0.9rem 1rem;
         }
      }
   }
</style>
