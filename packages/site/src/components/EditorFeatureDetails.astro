---
import type { EditorSupportProfile } from '@a1st/aix-schema';
import {
   editorFeatureDefinitions,
   getFeatureAnchor,
   getFeatureConceptRoute,
   getFeatureProseLabel,
} from '../lib/editor-support';
import InlineCodeText from './InlineCodeText.astro';
import ScopeSupportDetails from './ScopeSupportDetails.astro';
import SupportStatusBadge from './SupportStatusBadge.astro';

interface Props {
   profile: EditorSupportProfile;
}

const { profile } = Astro.props;
---

<div class="editor-feature-details aix-layout">
   {editorFeatureDefinitions.map((featureDefinition) => {
      const feature = profile.features[featureDefinition.id],
            conceptRoute = getFeatureConceptRoute(featureDefinition.id),
            anchor = getFeatureAnchor(profile.id, featureDefinition.id);

      return (
         <section class="editor-feature-details__feature aix-card aix-layout" aria-labelledby={anchor}>
            <div class="editor-feature-details__header aix-layout">
               <h3 id={anchor}>{featureDefinition.label}</h3>
               <SupportStatusBadge status={feature.summary} />
            </div>

            <p class="editor-feature-details__summary">
               <InlineCodeText text={feature.implementation} />
            </p>

            <p class="editor-feature-details__meta">
               {profile.name} calls this <strong>{feature.terminology}</strong>.
               {conceptRoute && (
                  <>
                     {' '}
                     <a href={conceptRoute}>How aix handles {getFeatureProseLabel(featureDefinition)}</a>
                  </>
               )}
            </p>

            <dl class="editor-feature-details__scope-list aix-layout">
               <ScopeSupportDetails label="Project" scope={feature.project} />
               <ScopeSupportDetails label="User" scope={feature.user} />
            </dl>

            {feature.supportedValues && feature.supportedValues.length > 0 && (
               <p class="editor-feature-details__values">
                  <strong>Supported metadata:</strong>{' '}
                  {feature.supportedValues.map((value, index) => (
                     <>
                        {index > 0 && ', '}
                        <code>{value}</code>
                     </>
                  ))}
               </p>
            )}

            {feature.notes && feature.notes.length > 0 && (
               <ul class="editor-feature-details__notes">
                  {feature.notes.map((note) => (
                     <li>
                        <InlineCodeText text={note} />
                     </li>
                  ))}
               </ul>
            )}
         </section>
      );
   })}
</div>

<style>
   .editor-feature-details {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
   }

   .editor-feature-details__feature {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
   }

   .editor-feature-details__header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.4rem 1rem;
   }

   .editor-feature-details__summary,
   .editor-feature-details__meta {
      max-inline-size: 65ch;
   }

   .editor-feature-details__meta {
      color: var(--sl-color-gray-2);
   }

   .editor-feature-details__scope-list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
   }

   .editor-feature-details__values,
   .editor-feature-details__notes {
      overflow-wrap: anywhere;
   }
</style>
