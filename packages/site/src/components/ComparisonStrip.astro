---
import { Icon } from 'astro-icon/components';

/**
 * Before and after lists showing several per-editor config files replaced by one.
 */
const REVEAL_START_SECONDS = 0.2,
      REVEAL_STAGGER_SECONDS = 0.06;

const beforeFiles = [
  '.cursor/rules',
  '.github/copilot-instructions.md',
  '.windsurf/rules',
  '.claude/CLAUDE.md',
  '.zed/settings.json',
  'AGENTS.md',
];
---

<div class="comparison-strip-container">
  <div class="comparison-strip reveal">
    <div class="comparison-strip__before">
      <p class="comparison-strip__heading">Before</p>
      <ul class="comparison-strip__files">
        {beforeFiles.map((f, i) => (
          <li
            class="comparison-strip__file comparison-strip__file--old reveal"
            style={`--reveal-delay: ${REVEAL_START_SECONDS + i * REVEAL_STAGGER_SECONDS}s`}
          >
            {f}
          </li>
        ))}
      </ul>
    </div>

    <div class="comparison-strip__arrow" aria-hidden="true">
      <Icon name="lucide:arrow-right" />
    </div>

    <div class="comparison-strip__after">
      <p class="comparison-strip__heading">After</p>
      <ul class="comparison-strip__files">
        <li class="comparison-strip__file comparison-strip__file--new">ai.json</li>
      </ul>
    </div>
  </div>
</div>

<style>
  .comparison-strip-container {
    container-type: inline-size;
    max-width: 760px;
    margin-inline: auto;
  }
  .comparison-strip {
    --reveal-distance: 0.5rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 2.5rem 1.5rem;
    background: var(--aix-surface-sunken);
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 12px;
  }
  .comparison-strip__heading {
    font-family: var(--sl-font-system-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--aix-text-muted);
    margin-block-end: 0.6rem;
    text-align: center;
  }
  .comparison-strip__files {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
    list-style: none;
  }
  .comparison-strip__file {
    --reveal-distance: 0.25rem;

    font-family: var(--sl-font-system-mono);
    font-size: 0.72rem;
    padding: 3px 10px;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  /* The strike-through is what marks these as replaced; the color only reinforces it. */
  .comparison-strip__file--old {
    background: var(--aix-error-subtle);
    color: var(--aix-error);
    border: 1px solid var(--aix-error-border);
    text-decoration: line-through;
    text-decoration-color: var(--aix-error-muted);
  }
  .comparison-strip__file--new {
    background: var(--aix-success-subtle);
    color: var(--aix-success);
    border: 1px solid var(--aix-success-border);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 8px 20px;
  }
  .comparison-strip__arrow {
    flex-shrink: 0;
    width: 40px;
    height: 24px;
    color: var(--sl-color-accent);
    rotate: 90deg;
  }

  /* Wide enough for both lists side by side: point the arrow across. */
  @container (min-width: 34rem) {
    .comparison-strip {
      flex-direction: row;
      gap: 2rem;
    }
    .comparison-strip__arrow {
      rotate: none;
    }
  }
</style>
