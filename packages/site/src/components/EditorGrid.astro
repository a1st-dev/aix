---
/**
 * Row of supported editors with a connecting line motif. The row wraps, and drops the
 * line, when the container is too narrow to hold every editor.
 */
import { Icon } from 'astro-icon/components';
import { editorIconNames, editorSupportProfiles, getEditorSupportRoute } from '../lib/editor-support';

const REVEAL_START_SECONDS = 0.3,
      REVEAL_STAGGER_SECONDS = 0.08;

const editors = editorSupportProfiles.map((editor) => ({
  href: getEditorSupportRoute(editor.id),
  name: editor.name,
  icon: editorIconNames[editor.id],
}));
---

<div class="editor-grid">
  <div class="editor-grid__line" aria-hidden="true"></div>
  <ul class="editor-grid__items">
    {editors.map((editor, i) => (
      <li class="reveal" style={`--reveal-delay: ${REVEAL_START_SECONDS + i * REVEAL_STAGGER_SECONDS}s`}>
        <a href={editor.href} class="editor-grid__item">
          <span class="editor-grid__icon">
            <Icon name={editor.icon} aria-hidden="true" />
          </span>
          <span class="editor-grid__name">{editor.name}</span>
          <span class="editor-grid__dot" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style lang="scss">
  .editor-grid {
    container-type: inline-size;
    position: relative;
    padding-block: 2rem;
    max-inline-size: 52rem;
    margin-inline: auto;
  }
  .editor-grid__line {
    display: none;
    position: absolute;
    top: 50%;
    inset-inline: 5%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--sl-color-accent) 20%,
      var(--sl-color-accent) 80%,
      transparent
    );
    opacity: 0.3;
  }
  .editor-grid__items {
    --editor-grid-columns: 3;
    --editor-grid-gap: 0.5rem;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--editor-grid-gap);
    position: relative;
    list-style: none;
  }
  .editor-grid__items > li {
    flex: 0 0 calc((100% + var(--editor-grid-gap)) / var(--editor-grid-columns) - var(--editor-grid-gap));
    min-inline-size: 0;
  }
  .editor-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0.5rem;
    position: relative;
    color: inherit;
    text-decoration: none;
  }
  .editor-grid__icon {
    color: var(--sl-color-accent);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-bg-nav);
  }
  .editor-grid__icon :global(svg) {
    width: 24px;
    height: 24px;
  }
  .editor-grid__item:hover .editor-grid__icon,
  .editor-grid__item:focus-visible .editor-grid__icon {
    border-color: var(--sl-color-accent);
  }
  .editor-grid__item:hover .editor-grid__name,
  .editor-grid__item:focus-visible .editor-grid__name {
    color: var(--sl-color-white);
  }
  .editor-grid__name {
    font-family: var(--sl-font);
    font-size: 0.75rem;
    color: var(--aix-text-muted);
    letter-spacing: 0.03em;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .editor-grid__dot {
    display: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sl-color-accent);
    opacity: 0.5;
    position: absolute;
    bottom: -14px;
  }

  @container (min-width: 35rem) {
    .editor-grid__items {
      --editor-grid-columns: 5;
    }
  }

  /* Wide enough for one row: spread the editors out and thread the line through them. */
  @container (min-width: 51rem) {
    .editor-grid__items {
      justify-content: space-between;
    }
    .editor-grid__items > li {
      flex-basis: auto;
    }
    .editor-grid__line,
    .editor-grid__dot {
      display: block;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .editor-grid__icon {
      transition:
        border-color 0.3s,
        transform 0.3s;
    }
    .editor-grid__item:hover .editor-grid__icon {
      transform: translateY(-3px);
    }
  }
</style>
