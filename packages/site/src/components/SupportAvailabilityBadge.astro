---
import { getAvailabilityDescription, getAvailabilityLabel } from '../lib/editor-support';
import SupportBadge from './SupportBadge.astro';

interface Props {
   compact?: boolean;
   supported: boolean;
}

const { compact = false, supported } = Astro.props;
---

<SupportBadge
   compact={compact}
   description={getAvailabilityDescription(supported)}
   label={getAvailabilityLabel(supported)}
   tone={supported ? 'positive' : 'negative'}
/>
