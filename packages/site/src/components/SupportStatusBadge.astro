---
import type { EditorSupportStatus } from '@a1st/aix-schema';
import { getStatusDescription, getStatusLabel } from '../lib/editor-support';
import SupportBadge from './SupportBadge.astro';

interface Props {
   compact?: boolean;
   status: EditorSupportStatus;
}

const { compact = false, status } = Astro.props;

const tones = {
   native: 'positive',
   shim: 'partial',
   unsupported: 'negative',
} as const satisfies Record<EditorSupportStatus, 'positive' | 'partial' | 'negative'>;
---

<SupportBadge
   compact={compact}
   description={getStatusDescription(status)}
   label={getStatusLabel(status)}
   tone={tones[status]}
/>
