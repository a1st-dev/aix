---
/**
 * Key for the two kinds of support badge. It has no headings of its own so it can sit
 * inside any section without changing the page outline.
 */
import type { EditorSupportStatus } from '@a1st/aix-schema';
import { getAvailabilityDescription, getStatusDescription } from '../lib/editor-support';
import SupportAvailabilityBadge from './SupportAvailabilityBadge.astro';
import SupportStatusBadge from './SupportStatusBadge.astro';

const statuses: readonly EditorSupportStatus[] = [ 'native', 'shim', 'unsupported' ];
---

<div class="support-legend aix-card aix-layout">
   <p class="support-legend__title">Support key</p>

   <div class="support-legend__groups aix-layout">
      <div class="support-legend__group aix-layout">
         <p class="aix-eyebrow" id="support-legend-editor">Editor support</p>
         <dl class="support-legend__list aix-layout" aria-labelledby="support-legend-editor">
            {[ true, false ].map((supported) => (
               <div class="support-legend__item">
                  <dt><SupportAvailabilityBadge supported={supported} /></dt>
                  <dd>{getAvailabilityDescription(supported)}</dd>
               </div>
            ))}
         </dl>
      </div>

      <div class="support-legend__group aix-layout">
         <p class="aix-eyebrow" id="support-legend-aix">aix support</p>
         <dl class="support-legend__list aix-layout" aria-labelledby="support-legend-aix">
            {statuses.map((status) => (
               <div class="support-legend__item">
                  <dt><SupportStatusBadge status={status} /></dt>
                  <dd>{getStatusDescription(status)}</dd>
               </div>
            ))}
         </dl>
      </div>
   </div>

   <p class="support-legend__footnote">
      <abbr class="aix-term" title="Configuration written into the current repository or workspace.">Project scope</abbr>
      {' '}and <abbr class="aix-term" title="Configuration written into the editor's home or profile-level location.">user scope</abbr>
      {' '}are listed separately because an editor can support a feature at one and not the other.
   </p>
</div>

<style>
   .support-legend {
      display: grid;
      gap: 0.85rem;
      margin-block: 1.5rem;
   }

   .support-legend__title {
      font-weight: 600;
   }

   .support-legend__groups {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2rem;
   }

   .support-legend__group {
      display: grid;
      flex: 1 1 16rem;
      gap: 0.5rem;
      align-content: start;
   }

   .support-legend__list {
      display: grid;
      gap: 0.5rem;
   }

   .support-legend__item {
      display: grid;
      grid-template-columns: 5.75rem minmax(0, 1fr);
      gap: 0.6rem;
      align-items: baseline;
   }

   .support-legend__item dd,
   .support-legend__footnote {
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      line-height: 1.5;
   }

   .support-legend__item dt {
      font-weight: 400;
   }

   .support-legend__item dd {
      margin: 0;
   }
</style>
