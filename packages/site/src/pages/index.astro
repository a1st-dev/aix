---
import { SEO } from 'astro-seo';
import { Icon } from 'astro-icon/components';
import CodeBlock from '../components/CodeBlock.astro';
import TerminalBlock from '../components/TerminalBlock.astro';
import EditorGrid from '../components/EditorGrid.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ComparisonStrip from '../components/ComparisonStrip.astro';
import logoDarkSrc from '../assets/logo-dark.svg?url';
import logoLightSrc from '../assets/logo-light.svg?url';
import { editorSupportProfiles, formatEditorNameList } from '../lib/editor-support';

import '../styles/fonts.css';
import '../styles/theme.scss';
import '../styles/landing.scss';

const supportedEditorsText = formatEditorNameList(editorSupportProfiles);
const title = 'aix — One config file. Every AI editor.';
const description =
  `Define your skills, rules, prompts, subagents, MCP servers, hooks, and plugins once in ai.json. Install to ${supportedEditorsText} with one command.`;
const siteUrl = 'https://aix.a1st.dev';
const ogImageUrl = `${siteUrl}/og/index.png`;
const repositoryUrl = 'https://github.com/a1st-dev/aix';
const docsHref = '/getting-started/introduction/';
const docsShortcuts = [
  { label: 'Quick start', href: '/getting-started/quick-start/' },
  { label: 'ai.json reference', href: '/configuration/ai-json-reference/' },
  { label: 'Use aix as a library', href: '/getting-started/use-as-a-library/' },
  { label: 'Supported editors', href: '/editors/supported-editors/' },
  { label: 'Migration guides', href: '/editors/migrations/' },
];

// Where a default, user-scope install puts MCP servers for each editor.
const mcpInstallTargets = editorSupportProfiles.map((profile) => ({
  name: profile.name,
  path: profile.features.mcp.user.path,
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Same storage key and fallback as the docs theme picker, so both follow one choice. -->
    <script is:inline>
      (() => {
        let storedTheme = null;

        try {
          storedTheme = localStorage.getItem('starlight-theme');
        } catch {
          // Storage can be blocked; the system preference below still applies.
        }

        const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        const theme = storedTheme || (prefersLight ? 'light' : 'dark');

        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      })();
    </script>
    <SEO
      title={title}
      description={description}
      canonical={siteUrl}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: ogImageUrl,
          url: siteUrl,
        },
        optional: {
          description,
          siteName: 'aix',
          locale: 'en_US',
        },
        image: {
          alt: 'aix — One config file. Every AI editor.',
          width: 1200,
          height: 630,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: ogImageUrl,
        imageAlt: 'aix — One config file. Every AI editor.',
      }}
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- Grain overlay -->
    <div class="grain" aria-hidden="true"></div>

    <!-- Navigation -->
    <header class="site-header">
      <nav class="nav" aria-label="Main">
        <a href="/" class="nav__logo" aria-label="aix home">
          <img src={logoDarkSrc} class="nav__logo-mark nav__logo-mark--dark" alt="" width="80" height="32" />
          <img src={logoLightSrc} class="nav__logo-mark nav__logo-mark--light" alt="" width="80" height="32" />
        </a>
        <ul class="nav__links">
          <li><a href={docsHref} class="nav__link">Docs</a></li>
          <li>
            <a href={repositoryUrl} class="nav__link" rel="noopener noreferrer">
              <Icon name="simple-icons:github" class="nav__github-icon" aria-hidden="true" />
              GitHub
              <Icon name="lucide:external-link" class="nav__external-icon" aria-hidden="true" />
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero">
        <div class="hero__container">
          <div class="hero__intro">
            <h1 class="hero__title">
              <span class="hero__title-line">One config file.</span>
              <span class="hero__title-line hero__title-line--2">Every AI editor.</span>
            </h1>
            <p class="hero__subtitle">
              Define your
              <a href="/concepts/skills/" class="highlight">skills</a>,
              <a href="/concepts/rules/" class="highlight">rules</a>,
              <a href="/concepts/prompts/" class="highlight">prompts</a>,
              <a href="/concepts/agents/" class="highlight">subagents</a>,
              <a href="/concepts/mcp-servers/" class="highlight">MCP servers</a>,
              <a href="/concepts/hooks/" class="highlight">hooks</a>, and
              <a href="/concepts/plugins/" class="highlight">plugins</a> in
              <code>ai.json</code>. Install that configuration across your editors with one command.
            </p>
            <div class="hero__cta-row">
              <a href="/getting-started/installation/" class="hero__cta">Get started</a>
              <a href="/getting-started/quick-start/" class="hero__cta hero__cta--secondary">
                Quick start →
              </a>
            </div>
          </div>
          <div class="hero__terminal">
            <TerminalBlock
              lines={[
                "npm install -g @a1st/aix",
                "aix init",
                "aix add skill obra/superpowers/skills/brainstorming --save",
                "aix install",
              ]}
            />
          </div>
        </div>
      </section>

      <!-- Editors -->
      <section class="section editors-section" aria-labelledby="editors-title">
        <div class="section__inner">
          <h2 class="section__eyebrow" id="editors-title">Works with</h2>
          <EditorGrid />
        </div>
      </section>

      <!-- Comparison -->
      <section class="section comparison-section" aria-labelledby="comparison-title">
        <div class="section__inner">
          <h2 class="section__title" id="comparison-title">One skill, three editors</h2>
          <p class="section__desc">
            Here’s how a team can share a code review skill across Cursor, Claude Code,
            and GitHub Copilot.
          </p>
          <ComparisonStrip />
        </div>
      </section>

      <!-- Features -->
      <section class="section features-section" aria-labelledby="features-title">
        <div class="section__inner">
          <h2 class="section__title" id="features-title">What you can do with aix</h2>
          <div class="features-section__cards">
            <FeatureCard
              label="aix install"
              title="Install one config across editors"
              description="Write ai.json once. aix translates it into each editor’s native format and installs it for your user account or the current project."
              language="bash"
              code="aix install"
              exampleLabel="Terminal"
              href="/cli/install/"
              linkLabel="Install a config"
            >
              <details class="install-targets">
                <summary>User-level MCP server paths</summary>
                <dl>
                  {mcpInstallTargets.map((target) => (
                    <div class="install-targets__row">
                      <dt>{target.name}</dt>
                      <dd><code>{target.path}</code></dd>
                    </div>
                  ))}
                </dl>
              </details>
            </FeatureCard>

            <FeatureCard
              label="extends"
              title="Standardize your team or project's AI config."
              description="Extend from npm packages, GitHub repos, or local paths. Layer your company's base config with project-specific overrides, the same way tsconfig.json does."
              language="json"
              code={`{
  "extends": "github:company/ai-config",
  "rules": {
    "testing": { "path": "./rules/testing.md" }
  }
}`}
              exampleLabel="ai.json"
              href="/configuration/config-inheritance/"
              linkLabel="Extend a config"
            />

            <FeatureCard
              label="aix search"
              title="Find skills and MCP servers."
              description="Search the skills.sh library and the official MCP Registry from the terminal. Browse the results and install the one you pick."
              language="bash"
              code={`# Open the interactive browser
aix search

# Or start from a query
aix search playwright --type mcp`}
              exampleLabel="Terminal"
              href="/cli/search/"
              linkLabel="Search from the terminal"
            />

            <FeatureCard
              label="@a1st/aix-core"
              title="Ship your tool's skill with your tool."
              description="Detect the user's AI editors during setup, ask which to configure, and install your skill or MCP server directly from your own tool."
              language="js"
              code={`import { fileURLToPath } from 'node:url';
import { detectEditors, installSkill } from '@a1st/aix-core';

const detected = await detectEditors();
const skillDir = fileURLToPath(new URL('./skills/my-cli', import.meta.url));

await installSkill({
  name: 'my-cli',
  source: { path: skillDir },
  scope: 'user',
  editors: detected.map(({ id }) => id),
});`}
              href="/getting-started/use-as-a-library/"
              linkLabel="Use aix as a library"
              exampleLabel="setup.mjs"
            />
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section class="section how-section" aria-labelledby="how-title">
        <div class="section__inner">
          <h2 class="section__title" id="how-title">Set up your project</h2>
          <ol class="how-section__steps" role="list">
            <li class="how-step">
              <span class="how-step__number" aria-hidden="true">01</span>
              <h3 class="how-step__title">Initialize</h3>
              <p class="how-step__desc">
                Create an <code>ai.json</code>, or import the config an editor
                already has with <code>--from claude-code</code>.
              </p>
              <div class="how-step__cmd"><CodeBlock code="aix init" language="bash" /></div>
            </li>
            <li class="how-step">
              <span class="how-step__number" aria-hidden="true">02</span>
              <h3 class="how-step__title">Configure</h3>
              <p class="how-step__desc">
                Save skills, rules, prompts, and MCP servers to <code>ai.json</code>
                from files, GitHub, or npm.
              </p>
              <div class="how-step__cmd"><CodeBlock code="aix add skill ./skills/review --save" language="bash" /></div>
            </li>
            <li class="how-step">
              <span class="how-step__number" aria-hidden="true">03</span>
              <h3 class="how-step__title">Install</h3>
              <p class="how-step__desc">
                Apply your config to your selected editors. Run it again
                whenever you change <code>ai.json</code>.
              </p>
              <div class="how-step__cmd"><CodeBlock code="aix install" language="bash" /></div>
            </li>
          </ol>
        </div>
      </section>

      <!-- CTA -->
      <section class="section cta-section" aria-labelledby="cta-title">
        <div class="section__inner">
          <div>
            <h2 class="cta-section__title" id="cta-title">Get started</h2>
            <div class="cta-section__install">
              <CodeBlock code="npm install -g @a1st/aix" language="bash" />
            </div>
            <div class="cta-section__links">
              <a href={docsHref} class="hero__cta">Read the docs</a>
              <a href={repositoryUrl} class="hero__cta hero__cta--secondary" rel="noopener noreferrer">
                View on GitHub →
              </a>
            </div>
          </div>
          <nav class="cta-section__guide-links" aria-label="Documentation shortcuts">
            <ul role="list">
              {docsShortcuts.map(({ href, label }) => (
                <li>
                  <a {href}>{label}<Icon name="lucide:arrow-right" aria-hidden="true" /></a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer__inner">
        <span class="footer__logo"><span class="footer__logo-ai">ai</span>x</span>
        <span class="footer__sep" aria-hidden="true">·</span>
        <a href={`${repositoryUrl}/blob/main/LICENSE`} class="footer__link" rel="noopener noreferrer">MIT License</a>
        <span class="footer__sep" aria-hidden="true">·</span>
        <a href={repositoryUrl} class="footer__link" rel="noopener noreferrer">GitHub</a>
      </div>
    </footer>
  </body>
</html>
