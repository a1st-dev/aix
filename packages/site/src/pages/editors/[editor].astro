---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { SupportedEditorName } from '@a1st/aix-schema';
import EditorFeatureDetails from '../../components/EditorFeatureDetails.astro';
import InlineCodeText from '../../components/InlineCodeText.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SupportLegend from '../../components/SupportLegend.astro';
import {
   editorSupportProfiles,
   getEditorById,
   getMigrationRoute,
   listMigrationPairsForEditor,
} from '../../lib/editor-support';
import { editorSupportSections, getEditorSupportHeadings, getEditorSupportPage } from '../../lib/editor-pages';

interface Props {
   editor: SupportedEditorName;
}

export function getStaticPaths() {
   return editorSupportProfiles.map((profile) => ({
      params: { editor: profile.id },
      props: { editor: profile.id },
   }));
}

const { editor } = Astro.props;

const profile = getEditorById(editor),
      { title, description } = getEditorSupportPage(profile),
      migrationPairs = listMigrationPairsForEditor(profile.id);
---

<StarlightPage
   frontmatter={{ title, description, editUrl: false }}
   headings={getEditorSupportHeadings(profile)}
>
   <p>{profile.summary}</p>

   <p>{profile.migrationPitch}</p>

   <p>
      This page lists the terms, support level, and project and user paths aix uses for {profile.name}.
      To compare every editor at once, see <a href="/editors/supported-editors/">the support matrix</a>.
   </p>

   {profile.notes.length > 0 && (
      <>
         <SectionHeading heading={editorSupportSections.notes} />
         <ul>
            {profile.notes.map((note) => (
               <li>
                  <InlineCodeText text={note} />
               </li>
            ))}
         </ul>
      </>
   )}

   <SectionHeading heading={editorSupportSections.features} />
   <SupportLegend />
   <EditorFeatureDetails profile={profile} />

   <SectionHeading heading={editorSupportSections.guides} />
   <p>Each guide compares {profile.name} with one other editor and gives the <code>aix sync</code> command for the move.</p>
   <ul class="aix-columns">
      {migrationPairs.map(({ from, to }) => (
         <li>
            <a href={getMigrationRoute(from, to)}>
               {getEditorById(from).name} to {getEditorById(to).name}
            </a>
         </li>
      ))}
   </ul>

</StarlightPage>
