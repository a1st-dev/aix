---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import InlineCodeText from '../../components/InlineCodeText.astro';
import { formatList } from '../../lib/editor-support';
import { editorChangelogPage } from '../../lib/editor-pages';
import {
   editorResearchStatusLabels,
   getVisitorNote,
   groupEditorResearchEntries,
   listEditorResearchEntries,
   type EditorResearchRelease,
   type EditorResearchStatus,
} from '../../lib/editor-research';

const { title, description } = editorChangelogPage;

const groups = groupEditorResearchEntries(listEditorResearchEntries()),
      releaseCount = groups.reduce((memo, group) => memo + group.releases.length, 0),
      // Outcomes worth calling out in a collapsed row. "No effect" and "Reviewed" are the
      // normal case and would only add noise there.
      notableStatuses: readonly EditorResearchStatus[] = [ 'follow-up', 'supported' ];

function pluralize(count: number, noun: string): string {
   return `${count} ${noun}${count === 1 ? '' : 's'}`;
}

function describeRelease(release: EditorResearchRelease): string {
   const notable = notableStatuses
      .filter((status) => release.statusCounts[status] > 0)
      .map((status) => `${release.statusCounts[status]} ${editorResearchStatusLabels[status].toLowerCase()}`);

   // A repeated version already carries its review date in the heading.
   const reviewed = release.heading.includes(release.reviewedOn) ? [] : [ `Reviewed ${release.reviewedOn}` ];

   return [ ...reviewed, pluralize(release.entry.changes.length, 'change'), ...notable ].join(' · ');
}

function listSourceHosts(sourceURLs: readonly string[]): string[] {
   return [ ...new Set(sourceURLs.map((sourceURL) => new URL(sourceURL).hostname)) ];
}
---

<StarlightPage
   frontmatter={{ title, description, editUrl: false }}
   headings={groups.map((group) => ({ depth: 2, slug: group.editorID, text: group.editorName }))}
>
   <p>
      The aix maintainers read each supported editor's release notes and record what, if anything,
      aix has to do about them. This page is that record: {pluralize(releaseCount, 'release')} across
      {' '}{pluralize(groups.length, 'editor')}, newest first. It is a log of compatibility checks,
      not the release notes for aix itself, which are on{' '}
      <a href="https://github.com/a1st-dev/aix/releases">GitHub</a>.
   </p>

   <p>Open a release to see its changes. Each change is marked with one of these outcomes:</p>

   <dl class="editor-changelog__key aix-layout">
      <div class="aix-layout">
         <dt>{editorResearchStatusLabels.supported}</dt>
         <dd>aix already handles the change, or was updated to.</dd>
      </div>
      <div class="aix-layout">
         <dt>{editorResearchStatusLabels['follow-up']}</dt>
         <dd>aix does not handle the change yet.</dd>
      </div>
      <div class="aix-layout">
         <dt>{editorResearchStatusLabels['no-change']}</dt>
         <dd>The change is outside the files aix reads and writes.</dd>
      </div>
      <div class="aix-layout">
         <dt>{editorResearchStatusLabels.unknown}</dt>
         <dd>The change was noted without one of the outcomes above.</dd>
      </div>
   </dl>

   {groups.map((group) => {
      const [ latest ] = group.releases,
            upstreamNames = [ ...new Set(group.releases.map((release) => release.productName)) ]
               .filter((name) => name !== group.editorName);

      return (
         <>
            <h2 id={group.editorID}>{group.editorName}</h2>
            <p>
               {pluralize(group.releases.length, 'release')} reviewed, most recently on {latest?.reviewedOn}.
               {upstreamNames.length > 0 && (
                  <>
                     {' '}Most of these notes follow {formatList(upstreamNames)} releases, which is where aix
                     tracks changes that affect {group.editorName}. The version in each title belongs to
                     the product named beside it.
                  </>
               )}
            </p>

            <div class="editor-changelog__releases aix-layout">
               {group.releases.map((release) => (
                  <details class="editor-changelog__release">
                     <summary>
                        <h3 id={release.anchor}>{release.heading}</h3>
                        <span class="editor-changelog__meta">{describeRelease(release)}</span>
                     </summary>

                     <ul class="editor-changelog__changes aix-layout">
                        {release.entry.changes.map((change) => {
                           const note = getVisitorNote(change.aixStatus);

                           return (
                              <li class="editor-changelog__change aix-layout">
                                 <p><InlineCodeText text={change.summary} /></p>
                                 <p class="editor-changelog__outcome">
                                    <strong>{editorResearchStatusLabels[change.status]}.</strong>
                                    {note && <>{' '}<InlineCodeText text={note} /></>}
                                 </p>
                              </li>
                           );
                        })}
                     </ul>

                     {release.entry.sourceURLs.length > 0 && (
                        <p class="editor-changelog__sources">
                           Sources: {formatList(listSourceHosts(release.entry.sourceURLs))}
                        </p>
                     )}
                  </details>
               ))}
            </div>
         </>
      );
   })}

   <style>
      .editor-changelog__key {
         display: grid;
         gap: 0.35rem;
      }

      /* Term and description share a row when there is room and stack when there is not. */
      .editor-changelog__key div {
         display: flex;
         flex-wrap: wrap;
         gap: 0 1rem;
      }

      .editor-changelog__key dt {
         flex: 0 0 10rem;
         font-weight: 600;
      }

      .editor-changelog__key dd {
         flex: 1 1 16rem;
         margin: 0;
      }

      .editor-changelog__releases {
         display: grid;
         grid-template-columns: minmax(0, 1fr);
         border-block-start: 1px solid var(--sl-color-hairline-light);
      }

      /* Rows are separated by rules, so Starlight's accent bar and indent are not needed. */
      .editor-changelog__release {
         padding-inline-start: 0;
         border-inline-start: 0;
         border-block-end: 1px solid var(--sl-color-hairline-light);
      }

      .editor-changelog__release summary {
         padding-block: 0.6rem;
         cursor: pointer;
      }

      .editor-changelog__release h3 {
         display: inline;
         margin-inline-end: 0.75rem;
         font-size: 1.15rem;
      }

      .editor-changelog__meta {
         display: inline-block;
         font-weight: 400;
      }

      .editor-changelog__meta,
      .editor-changelog__sources {
         color: var(--aix-text-muted);
         font-size: var(--sl-text-sm);
      }

      .editor-changelog__changes {
         display: grid;
         grid-template-columns: minmax(0, 1fr);
         gap: 1rem;
         padding: 0;
         margin-block: 0.25rem 1rem;
         list-style: none;
      }

      .editor-changelog__change {
         display: grid;
         grid-template-columns: minmax(0, 1fr);
         gap: 0.3rem;
         padding-inline-start: 0.9rem;
         border-inline-start: 2px solid var(--sl-color-hairline-light);
         overflow-wrap: anywhere;
      }

      .editor-changelog__outcome {
         color: var(--sl-color-gray-2);
         font-size: 0.94em;
      }

      .editor-changelog__sources {
         margin-block-end: 1rem;
         overflow-wrap: anywhere;
      }
   </style>
</StarlightPage>
