---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import {
   editorSupportProfiles,
   getEditorById,
   getMigrationRoute,
   getMigrationTitle,
   indexableMigrationPairs,
} from '../../../lib/editor-support';
import { getMigrationFromSection, migrationGuidesPage } from '../../../lib/editor-pages';

const { title, description, sections } = migrationGuidesPage;

const featuredMigrationPairs = indexableMigrationPairs.map(({ from, to }) => ({
         from: getEditorById(from),
         to: getEditorById(to),
      })),
      fromSections = editorSupportProfiles.map((profile) => ({
         profile,
         heading: getMigrationFromSection(profile),
      }));
---

<StarlightPage
   frontmatter={{ title, description, editUrl: false }}
   headings={[ sections.featured, ...fromSections.map(({ heading }) => heading) ]}
>
   <p>
      Start with the editor you use today. Each guide gives the <code>aix sync</code> command for the
      move, lists what changes, and compares the two editors feature by feature: what the destination
      calls each feature and where project or user config ends up.
   </p>

   <SectionHeading heading={sections.featured} />
   <ul class="aix-columns">
      {featuredMigrationPairs.map(({ from, to }) => (
         <li>
            <a href={getMigrationRoute(from.id, to.id)}>{getMigrationTitle(from, to)}</a>
         </li>
      ))}
   </ul>

   {fromSections.map(({ profile: fromProfile, heading }) => (
      <>
         <SectionHeading heading={heading} />
         <ul class="aix-columns">
            {editorSupportProfiles
               .filter((toProfile) => toProfile.id !== fromProfile.id)
               .map((toProfile) => (
                  <li>
                     <a href={getMigrationRoute(fromProfile.id, toProfile.id)}>
                        {fromProfile.name} to {toProfile.name}
                     </a>
                  </li>
               ))}
         </ul>
      </>
   ))}

</StarlightPage>
