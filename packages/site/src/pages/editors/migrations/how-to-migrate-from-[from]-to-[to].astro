---
import { Code } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { SupportedEditorName } from '@a1st/aix-schema';
import ScopeSupportDetails from '../../../components/ScopeSupportDetails.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import SupportLegend from '../../../components/SupportLegend.astro';
import {
   describeTransition,
   getEditorById,
   getEditorSupportRoute,
   getFeatureConceptRoute,
   getFeatureProseLabel,
   getMigrationDescription,
   getMigrationHeadline,
   getMigrationRoute,
   getMigrationRows,
   getMigrationTitle,
   isIndexableMigrationPair,
   listChangedMigrationRows,
   listMigrationPairs,
} from '../../../lib/editor-support';
import { migrationGuideSections } from '../../../lib/editor-pages';

interface Props {
   from: SupportedEditorName;
   to: SupportedEditorName;
}

export function getStaticPaths() {
   return listMigrationPairs().map(({ from, to }) => ({
      params: { from, to },
      props: { from, to },
   }));
}

const { from, to } = Astro.props;

const fromProfile = getEditorById(from),
      toProfile = getEditorById(to),
      rows = getMigrationRows(from, to),
      changedRows = listChangedMigrationRows(rows),
      isIndexable = isIndexableMigrationPair(from, to),
      sides = [ fromProfile, toProfile ],
      syncCommand = `aix sync ${fromProfile.id} --to ${toProfile.id}`,
      title = getMigrationTitle(fromProfile, toProfile),
      description = getMigrationDescription(fromProfile, toProfile, rows);
---

<StarlightPage
   frontmatter={{
      title,
      description,
      editUrl: false,
      // Only the featured pairs are offered to search engines and to site search. The other
      // generated pairs would fill both with near-identical results.
      pagefind: isIndexable,
      head: isIndexable
         ? []
         : [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, follow' } }],
   }}
   headings={Object.values(migrationGuideSections)}
>
   <p>
      aix is a CLI for defining, installing, and syncing AI editor configuration. If you are moving
      from {fromProfile.name} to {toProfile.name}, this guide shows what aix can carry over, what
      {toProfile.name} calls each feature, and where the config ends up.
   </p>

   <SectionHeading heading={migrationGuideSections.run} />
   <ol>
      <li>
         Preview the migration. Nothing is written, and <code>aix sync</code> reads and writes user-scope
         config unless you say otherwise:
         <Code code={`${syncCommand} --dry-run`} lang="sh" />
      </li>
      <li>
         Read the preview for skipped or converted features, then run it for real:
         <Code code={syncCommand} lang="sh" />
      </li>
      <li>
         Open the files {toProfile.name} now has and check them against the paths in the comparison below.
         Add <code>--scope project</code> to both commands when the config you are moving lives in the project.
      </li>
   </ol>

   <SectionHeading heading={migrationGuideSections.attention} />
   {changedRows.length > 0 ? (
      <ul>
         {changedRows.map((row) => (
            <li><strong>{row.feature.label}:</strong> {describeTransition(fromProfile, toProfile, row)}</li>
         ))}
      </ul>
   ) : (
      <p>Nothing changes between these two editors. Check the destination paths below before you run the command.</p>
   )}

   <SectionHeading heading={migrationGuideSections.comparison} />
   <p>
      {getMigrationHeadline(rows)} Each feature shows {fromProfile.name} first and {toProfile.name}
      second, with what the editor supports and what aix writes at project and user scope.
   </p>

   <SupportLegend />

   <div class="migration-guide__features aix-layout">
      {rows.map((row) => {
         const conceptRoute = getFeatureConceptRoute(row.feature.id),
               headingID = `feature-${row.feature.id}`;

         return (
            <section class="migration-guide__feature aix-card aix-layout" aria-labelledby={headingID}>
               <h3 id={headingID}>{row.feature.label}</h3>
               <p class="migration-guide__summary">
                  {describeTransition(fromProfile, toProfile, row)}
                  {conceptRoute && (
                     <>
                        {' '}
                        <a href={conceptRoute}>How aix handles {getFeatureProseLabel(row.feature)}</a>
                     </>
                  )}
               </p>

               <div class="migration-guide__sides aix-layout">
                  {sides.map((profile) => {
                     const support = profile.features[row.feature.id];

                     return (
                        <div class="migration-guide__side aix-layout">
                           <p class="aix-eyebrow">{profile.name}</p>
                           <p class="migration-guide__term">{support.terminology}</p>
                           <dl class="migration-guide__scope-list aix-layout">
                              <ScopeSupportDetails label="Project" scope={support.project} />
                              <ScopeSupportDetails label="User" scope={support.user} />
                           </dl>
                        </div>
                     );
                  })}
               </div>
            </section>
         );
      })}
   </div>

   <SectionHeading heading={migrationGuideSections.links} />
   <ul>
      <li>
         <a href={getEditorSupportRoute(fromProfile.id)}>{fromProfile.name} support details</a>
      </li>
      <li>
         <a href={getEditorSupportRoute(toProfile.id)}>{toProfile.name} support details</a>
      </li>
      <li>
         <a href={getMigrationRoute(to, from)}>{getMigrationTitle(toProfile, fromProfile)}</a>
      </li>
      <li>
         <a href={`/editors/migrations/#${fromProfile.id}`}>All guides that start from {fromProfile.name}</a>
      </li>
   </ul>

   <style>
      .migration-guide__features {
         display: grid;
         grid-template-columns: minmax(0, 1fr);
         gap: 1.25rem;
      }

      .migration-guide__feature {
         display: grid;
         grid-template-columns: minmax(0, 1fr);
         gap: 0.75rem;
      }

      .migration-guide__summary {
         color: var(--sl-color-gray-2);
      }

      /* The two editors sit side by side when there is room and stack when there is not. */
      .migration-guide__sides {
         display: flex;
         flex-wrap: wrap;
         gap: 1rem 2rem;
      }

      .migration-guide__side {
         display: grid;
         flex: 1 1 16rem;
         grid-template-columns: minmax(0, 1fr);
         gap: 0.35rem;
         align-content: start;
         min-inline-size: 0;
      }

      .migration-guide__term {
         color: var(--sl-color-white);
         font-weight: 600;
      }

      .migration-guide__scope-list {
         display: grid;
         grid-template-columns: minmax(0, 1fr);
      }
   </style>
</StarlightPage>
