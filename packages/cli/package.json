{
   "name": "@a1st/aix",
   "version": "0.10.1",
   "description": "CLI for aix - unified AI agent configuration",
   "keywords": [
      "agents",
      "ai",
      "ai-config",
      "claude",
      "claude-code",
      "cli",
      "codex",
      "copilot",
      "cursor",
      "mcp",
      "skills",
      "windsurf",
      "zed"
   ],
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "https://github.com/a1st-dev/aix.git",
      "directory": "packages/cli"
   },
   "bin": {
      "aix": "./dist/cli.js",
      "aixd": "./bin/aixd.mjs"
   },
   "files": [
      "bin",
      "dist",
      "oclif.manifest.json",
      "theme.json"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "publishConfig": {
      "access": "public",
      "registry": "https://registry.npmjs.org/"
   },
   "scripts": {
      "prepack": "npm run build && npm run manifest",
      "postpack": "rm -f oclif.manifest.json",
      "build": "rm -rf dist tsconfig.build.tsbuildinfo oclif.manifest.json && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
      "manifest": "oclif manifest",
      "dev": "node bin/aixd.mjs",
      "test": "node ../../scripts/test-runner.mjs run",
      "test:watch": "node ../../scripts/test-runner.mjs"
   },
   "dependencies": {
      "@a1st/aix-core": "*",
      "@a1st/aix-schema": "*",
      "@a1st/mcp-registry-client": "*",
      "@inquirer/prompts": "^7.2.1",
      "@oclif/core": "^4.2.10",
      "@oclif/plugin-autocomplete": "^3.2.25",
      "@oclif/plugin-help": "^6.2.27",
      "@oclif/plugin-not-found": "^3.2.39",
      "@oclif/plugin-version": "^2.2.24",
      "@oclif/table": "0.3.6",
      "chalk": "^5.4.1",
      "compare-versions": "6.1.1",
      "ink": "4.4.1",
      "ink-text-input": "5.0.1",
      "ora": "^8.1.1",
      "p-map": "7.0.4",
      "pathe": "1.1.2",
      "react": "18.2.0",
      "tinyexec": "1.4.0"
   },
   "devDependencies": {
      "@oclif/test": "^4.1.12",
      "@types/node": "^22.10.2",
      "@types/react": "18.2.45",
      "oclif": "^4.17.8",
      "tsx": "4.23.1",
      "typescript": "^5.7.2",
      "vitest": "^4.1.5"
   },
   "oclif": {
      "bin": "aix",
      "commands": {
         "strategy": "pattern",
         "target": "./dist/commands"
      },
      "dirname": "aix",
      "flexibleTaxonomy": true,
      "helpClass": "./dist/lib/help.js",
      "hooks": {
         "postrun": "./dist/hooks/postrun/patch-autocomplete.js"
      },
      "plugins": [
         "@oclif/plugin-help",
         "@oclif/plugin-version",
         "@oclif/plugin-autocomplete",
         "@oclif/plugin-not-found"
      ],
      "theme": "theme.json",
      "topicSeparator": " ",
      "topics": {
         "add": {
            "description": "Install skills, MCP servers, agents, rules, prompts, hooks, plugins, or marketplaces"
         },
         "config": {
            "description": "Manage aix configuration"
         },
         "list": {
            "description": "List native editor configuration"
         },
         "remove": {
            "description": "Remove skills, MCP servers, agents, rules, prompts, hooks, plugins, or marketplaces"
         }
      }
   }
}
