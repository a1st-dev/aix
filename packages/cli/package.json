{
   "name": "@a1st/aix",
   "version": "0.7.0",
   "description": "CLI for aix - unified AI agent configuration",
   "keywords": [
      "agents",
      "ai",
      "ai-config",
      "claude",
      "claude-code",
      "cli",
      "codex",
      "copilot",
      "cursor",
      "mcp",
      "skills",
      "windsurf",
      "zed"
   ],
   "repository": {
      "type": "git",
      "url": "https://github.com/a1st-dev/aix.git",
      "directory": "packages/cli"
   },
   "bin": {
      "aix": "./dist/cli.js",
      "aixd": "./bin/aixd.mjs"
   },
   "files": [
      "bin",
      "dist",
      "oclif.manifest.json",
      "theme.json"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "publishConfig": {
      "access": "public",
      "registry": "https://registry.npmjs.org/"
   },
   "scripts": {
      "prepack": "npm run build",
      "postpack": "rm -f oclif.manifest.json",
      "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json && chmod +x dist/cli.js && npm run manifest",
      "manifest": "oclif manifest",
      "dev": "node bin/aixd.mjs",
      "test": "vitest run",
      "test:watch": "vitest"
   },
   "dependencies": {
      "@a1st/aix-core": "*",
      "@a1st/aix-schema": "*",
      "@a1st/mcp-registry-client": "*",
      "@astrojs/starlight": "0.42.2",
      "@astrojs/vercel": "11.0.10",
      "@inquirer/prompts": "^8.7.2",
      "@oclif/core": "^5.0.0",
      "@oclif/plugin-autocomplete": "^4.0.0",
      "@oclif/plugin-help": "^7.0.0",
      "@oclif/plugin-not-found": "^4.0.0",
      "@oclif/plugin-update": "5.0.0",
      "@oclif/plugin-version": "^3.0.1",
      "@oclif/table": "1.0.1",
      "@yeskunall/astro-umami": "0.0.9",
      "astro": "7.3.3",
      "chalk": "^6.0.0",
      "defu": "6.1.7",
      "giget": "3.3.1",
      "ink": "7.1.1",
      "ink-spinner": "5.0.0",
      "ink-text-input": "6.0.0",
      "ora": "^9.4.1",
      "react": "19.3.0",
      "yaml": "2.9.1"
   },
   "devDependencies": {
      "@oclif/test": "^4.1.12",
      "@types/node": "^22.10.2",
      "@types/react": "19.3.0",
      "oclif": "^4.17.8",
      "tsx": "4.23.1",
      "typescript": "^5.7.2",
      "vitest": "^5.0.1"
   },
   "oclif": {
      "bin": "aix",
      "commands": {
         "strategy": "pattern",
         "target": "./dist/commands"
      },
      "dirname": "aix",
      "flexibleTaxonomy": true,
      "helpClass": "./dist/lib/help.js",
      "hooks": {
         "postrun": "./dist/hooks/postrun/patch-autocomplete.js"
      },
      "plugins": [
         "@oclif/plugin-help",
         "@oclif/plugin-version",
         "@oclif/plugin-autocomplete",
         "@oclif/plugin-not-found",
         "@oclif/plugin-update"
      ],
      "theme": "theme.json",
      "topicSeparator": " ",
      "topics": {
         "add": {
            "description": "Install skills, MCP servers, agents, rules, prompts, hooks, plugins, or marketplaces"
         },
         "config": {
            "description": "Manage aix configuration"
         },
         "list": {
            "description": "List native editor configuration"
         },
         "remove": {
            "description": "Remove skills, MCP servers, agents, rules, prompts, hooks, plugins, or marketplaces"
         }
      },
      "update": {
         "s3": {
            "host": "https://github.com/a1st-dev/aix/releases/download/"
         }
      }
   }
}
