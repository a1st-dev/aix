{
   "name": "@a1st/aix-core",
   "version": "0.11.0",
   "description": "Core utilities for aix configuration loading and management",
   "keywords": [
      "ai-agent",
      "ai-config",
      "config-loader",
      "mcp",
      "model-context-protocol"
   ],
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "https://github.com/a1st-dev/aix.git",
      "directory": "packages/core"
   },
   "files": [
      "dist"
   ],
   "type": "module",
   "sideEffects": false,
   "main": "./dist/index.js",
   "browser": {
      "./src/runtime/node.ts": "./src/runtime/browser-dummy.ts",
      "./dist/runtime/node.js": "./dist/runtime/browser-dummy.js"
   },
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "publishConfig": {
      "access": "public",
      "registry": "https://registry.npmjs.org/"
   },
   "scripts": {
      "build": "tsc -p tsconfig.build.json",
      "test": "node ../../scripts/test-runner.mjs run",
      "test:watch": "node ../../scripts/test-runner.mjs"
   },
   "dependencies": {
      "@a1st/aix-schema": "*",
      "@decimalturn/toml-patch": "3.3.4",
      "confbox": "0.3.2",
      "detect-indent": "7.0.2",
      "giget": "3.3.1",
      "is-in-ci": "2.0.0",
      "js-yaml": "5.5.0",
      "nypm": "0.6.12",
      "p-map": "7.1.1",
      "pathe": "2.0.3",
      "tinyexec": "1.4.0"
   },
   "peerDependencies": {
      "zod": "^4.0.0"
   },
   "engines": {
      "node": ">=22.13.0"
   }
}
